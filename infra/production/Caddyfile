{
    admin off
    persist_config off
    email {$ACME_EMAIL}
    http_port 8080
    https_port 8443
    grace_period 1860s
    servers {
        protocols h1 h2
    }
    # Download tickets occur in URI paths; never emit access/request error objects.
    log default {
        output stdout
        format json
        exclude http.log.access http.log.error
    }
}

# Shared forwarding/cancellation policy; args are matcher and header timeout.
(api_proxy) {
    reverse_proxy {args[0]} api:3000 {
        header_up -Forwarded
        header_up -X-Real-IP
        header_up X-Forwarded-For {http.request.remote.host}
        header_up X-Forwarded-Host {http.request.host}
        header_up X-Forwarded-Proto https
        # Positive flushing retains cancellation on client disconnect.
        # Do NOT use -1: low-latency mode suppresses that cancellation.
        flush_interval 100ms
        transport http {
            dial_timeout 3s
            response_header_timeout {args[1]}
            compression off
        }
    }
}

{$PUBLIC_HOST} {
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Strict-Transport-Security "max-age=31536000"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }
    @api path /api /api/*
    handle @api {
        header X-Robots-Tag "noindex, nofollow"
        # Only authenticated QR upload needs multipart headroom. API guard still
        # runs before Multer; all other API endpoints retain the64KiB ceiling.
        @supportQRUpload {
            method POST
            path /api/v1/admin/support/qr
        }
        request_body @supportQRUpload {
            max_size 2162688
        }
        @otherAPI not {
            method POST
            path /api/v1/admin/support/qr
        }
        request_body @otherAPI {
            max_size 64KB
        }
        # Header waiting starts after the upstream request body is fully sent.
        # Only exact QR POST gets finite headroom over the application's20s guard.
        import api_proxy @supportQRUpload 25s
        import api_proxy @otherAPI 10s
    }
    # Only real public pages enter the application; missing files never become HTML200.
    redir /index.html / 308
    redir /privacy/ /privacy 308
    redir /terms/ /terms 308
    redir /report/ /report 308
    redir /ung-ho/ /ung-ho 308
    @admin path /admin /admin/*
    handle @admin {
        header X-Robots-Tag "noindex, nofollow"
        root * /srv
        rewrite * /admin.html
        file_server
    }
    @publicPages path /privacy /terms /report /ung-ho
    handle @publicPages {
        root * /srv
        encode zstd gzip
        rewrite * {path}.html
        file_server
    }
    handle / {
        root * /srv
        encode zstd gzip
        rewrite * /index.html
        file_server
    }
    @static path /assets/* /brand/* /favicon.png /apple-touch-icon.png /robots.txt /sitemap.xml
    handle @static {
        root * /srv
        encode zstd gzip
        file_server
    }
    handle {
        header X-Robots-Tag "noindex, nofollow"
        respond "Không tìm thấy trang" 404
    }
    # Error routes have their own header chain: deferred normal headers do not
    # run when file_server/proxy returns an error. Preserve its status explicitly.
    handle_errors {
        header {
            -Server
            X-Content-Type-Options nosniff
            Referrer-Policy no-referrer
            Strict-Transport-Security "max-age=31536000"
            Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
            X-Robots-Tag "noindex, nofollow"
            Cache-Control no-store
            Content-Type "text/plain; charset=utf-8"
        }
        respond "Không thể xử lý yêu cầu." {err.status_code}
    }
}

# Readiness inside this container only; not published by Compose.
http://127.0.0.1:8090 {
    respond /healthz 200
}
