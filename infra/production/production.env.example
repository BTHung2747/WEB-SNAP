# Copy OUTSIDE the repository to /etc/wed-snap/production.env; chmod600.
# This template contains no usable credentials. Never copy local .env values.
PUBLIC_HOST=download.example.invalid
ACME_EMAIL=
CONTACT_EMAIL=
PRODUCT_NAME=WED SNAP
# Exact reviewed release images. Prefer repository@sha256:...; no latest/local tags.
APP_IMAGE=
EGRESS_IMAGE=
WEB_IMAGE=
# Generate each separately: openssl rand -hex 32. Hex avoids DATABASE_URL escaping.
POSTGRES_PASSWORD=
ADMIN_SESSION_SECRET=
TIKTOK_EGRESS_CONTROL_SECRET=
# Select an unused RFC1918 subnet on TARGET; same value feeds network+control CIDR.
# No local subnet is silently reused. Verify host/VPC/VPN/Docker routes first.
PRODUCTION_PRIVATE_SUBNET=
# VERIFIED_PLATFORMS is fixed to youtube,tiktok; APP_ORIGIN derived as https://PUBLIC_HOST;
# COOKIE_SECURE is fixed true in compose.production.yaml.
# Target source acceptance is separate. Keep gates0 until assigned P5 checks.
TIKTOK_ADAPTER_ENABLED=0
TIKTOK_PHOTO_ENABLED=0
TIKTOK_VIDEO_ENABLED=0
TIKTOK_EGRESS_POLICY_ENABLED=0
MONTHLY_EGRESS_BYTES=10737418240
