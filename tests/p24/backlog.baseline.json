    "/api/v1/jobs/analyze": {
      "post": {
        "operationId": "JobsController_analyze",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Tác vụ được tiếp nhận; poll GET /jobs/:id để đọc kết quả",
