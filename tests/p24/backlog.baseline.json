    "/api/v1/downloads/{ticket}": {
      "get": {
        "operationId": "DownloadsController_download",
        "parameters": [
          {
            "name": "Range",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "bytes=0-99"
          }
        ],
        "responses": {
          "200": {
            "description": "MP4; HEAD chỉ trả headers",
            "content": {
              "video/mp4": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "Một byte Range hợp lệ; Content-Range và Accept-Ranges",
            "content": {
              "video/mp4": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "403": {
            "description": "Không có phiên hợp lệ"
          },
          "410": {
            "description": "Ticket/tệp hết hạn hoặc không thuộc phiên"
          },
          "416": {
            "description": "Range không hợp lệ; Content-Range: bytes */size"
          },
          "429": {
            "description": "Vượt rate limit"
          },
          "503": {
            "description": "Vượt ngân sách truyền mới"
          }
        },
        "summary": "MP4 qua máy chủ; Range 206/416; tạo transfer lease trước mở tệp",
        "tags": [
          "public"
        ],
        "security": [
          {
            "cookie": []
          }
        ]
      }
    },
