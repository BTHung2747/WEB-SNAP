              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "jobId"
                  ],
                  "properties": {
                    "jobId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED hoặc QUEUE_FULL; phân biệt bằng error.code",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "object",
                      "required": [
                        "code"
                      ],
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "RATE_LIMITED",
                            "QUEUE_FULL"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Tạo tác vụ phân tích; 202, thuộc phiên, không tải sẵn media",
        "tags": [
          "public"
        ],
        "security": [
          {
            "cookie": [],
            "csrf": []
          }
        ],
        "description": "Origin phải khớp APP_ORIGIN; x-csrf-token từ GET /api/v1/session.\n10 yêu cầu/60 giây/phiên và 30/60 giây/IP. RATE_LIMITED khác QUEUE_FULL (admission)."
      }
