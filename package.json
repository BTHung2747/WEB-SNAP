{
  "name": "wed-snap",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "npm run generate && tsc -p tsconfig.json && npm run build -w apps/web",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx tests/integration.ts",
    "migrate": "prisma migrate deploy",
    "admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.19.0",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "ioredis": "5.7.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "overrides": {
    "vite": "7.3.6",
    "postcss": "8.5.28",
    "js-yaml": "5.4.2",
    "@prisma/config": {
      "effect": "3.22.2",
      "deepmerge-ts": "8.0.2"
    }
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "prisma": "6.19.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "prettier": "3.6.2"
  }
}
