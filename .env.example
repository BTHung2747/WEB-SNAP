# Chạy scripts/init-env.ps1 để tạo secret ngẫu nhiên. Không commit .env.
POSTGRES_PASSWORD=
ADMIN_SESSION_SECRET=
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
CONTACT_EMAIL=
# Chỉ thêm sau khi đủ bằng chứng P0 trong docs/ADAPTERS.md.
VERIFIED_PLATFORMS=
# Công tắc tổng và từng loại TikTok; chỉ bật sau review, không bỏ global gate.
TIKTOK_ADAPTER_ENABLED=0
TIKTOK_PHOTO_ENABLED=0
TIKTOK_VIDEO_ENABLED=0
TIKTOK_EGRESS_POLICY_ENABLED=0
# Secret 64 hex thường và CIDR private thực tế; để trống trước khi được giao cấu hình.
TIKTOK_EGRESS_CONTROL_SECRET=
TIKTOK_EGRESS_CONTROL_NETWORKS=
MAX_DURATION_SECONDS=600
MAX_BYTES=209715200
MAX_INPUT_BYTES=262144000
ANALYZE_TIMEOUT_SECONDS=30
PREPARE_TIMEOUT_SECONDS=180
SESSION_TTL_SECONDS=120
RELEASE_GRACE_SECONDS=30
READY_TTL_SECONDS=600
SWEEP_SECONDS=30
LEASE_TTL_SECONDS=90
RETRY_GRACE_SECONDS=120
TRANSFER_MAX_SECONDS=1800
MONTHLY_EGRESS_BYTES=10737418240
DISK_STOP_PERCENT=80
QUEUE_LIMIT=20
